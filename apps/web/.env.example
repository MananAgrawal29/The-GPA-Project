# Browser configuration only.
#
# Everything in this file ships inside the client bundle, so it may never
# contain a secret, private API key, or database URL. Server-only values
# belong in the root .env.example instead.
#
# Only variables prefixed with VITE_ are exposed to browser code.

# Reserved: no screen calls the API yet. The shell routes to placeholder
# pages only, so this value is not read at runtime.
VITE_API_BASE_URL=http://localhost:3001

# When sign-in is wired (P07), Clerk's *publishable* key belongs here as a
# VITE_ variable, because the browser must send it. The Clerk *secret* key
# must never appear in this file or in any frontend code.
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_placeholder
