# Browser configuration only.
#
# Everything in this file ships inside the client bundle, so it may never
# contain a secret, private API key, or database URL. Server-only values
# belong in the root .env.example instead.
#
# Only variables prefixed with VITE_ are exposed to browser code.

# Base URL of the API. Leave it empty to call same-origin paths, which is
# what the Vite dev server proxy forwards to http://localhost:3001 in
# development. Production should serve the API and the web app from one
# host, so no origin is needed here either.
VITE_API_BASE_URL=

# Clerk's publishable key. Public by construction: it ships in the client
# bundle, which is exactly why it may live in a VITE_ variable. The API
# refuses to serve personal data until both this and the server-side
# CLERK_SECRET_KEY are set; without it this build shows an honest
# "sign-in required" notice instead of a form. The secret key must never
# appear in this file or anywhere in frontend code.
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_placeholder
