# Server-only configuration for The GPA Project.
#
# Copy this file to `.env` in the repository root (next to package.json).
# The API loads it at boot. Real environment variables always win over
# values in the file, so a host or shell setting takes precedence.
#
# Never commit a real .env. Never put one of these values in a VITE_
# variable: anything named VITE_ is compiled into the browser bundle.
#
# Nothing here is required to run the current foundation. `pnpm dev`
# starts the API health check and the identity page with no credentials.

# --- Core ---

# development | test | production
NODE_ENV=development

# Port the API listens on (1-65535). Defaults to 3001 when unset.
# PORT=0 is rejected deliberately: it would ask the OS for a random port,
# and the API must be reachable at a known address.
# If your shell or harness already exports PORT, set this line explicitly;
# an existing environment variable takes precedence over .env.
PORT=3001

# --- Reserved: not read by the application yet ---

# Required from P07, when persistence lands.
# DATABASE_URL=postgresql://gpa_user:change_me@localhost:5432/gpa

# Required from P07, when sign-in is wired. Server-side only; the
# browser gets Clerk's publishable key instead (see apps/web/.env.example).
# CLERK_SECRET_KEY=sk_test_placeholder
